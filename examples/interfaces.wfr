struct Person {
    name: String,
    age: i32,
}

struct Pet {
    name: String,
    species: String,
}

fn get_name[T](v: T) -> String {
    comptime @assert(@hasField(T, "name"), "T must have a name field")
    return @field(v, "name")
}

fn main() -> i32 {
    let p = Person{ .name = "Ada", .age = 36 }
    let pet = Pet{ .name = "Fido", .species = "dog" }
    print(get_name(p))
    print(get_name(pet))
    return 0
}
