struct Box {
    value: i32
}

fn swap(a: &mut i32, b: &mut i32) {
    let tmp = a.*
    a.* = b.*
    b.* = tmp
}

fn read(p: &i32) -> i32 {
    return p.*
}

fn replace(p: &mut i32, value: i32) {
    p.* = value
}

fn replaceIndirect(pp: &mut &mut i32, value: i32) {
    pp.*.* = value
}

fn main() -> i32 {
    mut left = 3
    mut right = 7
    swap(&mut left, &mut right)

    if read(&left) != 7 || read(&right) != 3 {
        return 1
    }
    print("pointer swap ok")

    mut boxed = Box{ .value = 5 }
    replace(&mut boxed.value, 8)

    mut pointed = 11
    mut pointer: &mut i32 = &mut pointed
    replaceIndirect(&mut pointer, 12)
    let same = &pointer.*

    if read(&boxed.value) == 8 && read(same) == 12 {
        print("pointer lvalues ok")
        return 0
    }
    return 1
}
