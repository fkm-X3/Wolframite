enum Result[T, E] {
    Ok(T),
    Err(E),
}

fn divide(a: i32, b: i32) -> Result[i32, String] {
    if b == 0 {
        return Err("division by zero")
    }
    return Ok(a / b)
}

fn compute(a: i32, b: i32, c: i32) -> Result[i32, String] {
    let x = divide(a, b)?
    let y = divide(x, c)?
    return Ok(y + 1)
}

fn main() -> i32 {
    let r = compute(100, 5, 2)
    return match r {
        Ok(v) => v,
        Err(e) => 0,
    }
}
