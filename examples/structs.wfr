struct Vec2 {
    x: i32,
    y: i32,
}

fn add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2{ .x = a.x + b.x, .y = a.y + b.y }
}

fn length_sum(v: Vec2) -> i32 {
    return v.x + v.y
}

fn main() -> i32 {
    let v1 = Vec2{ .x = 1, .y = 2 }
    let v2 = Vec2{ .x = 3, .y = 4 }
    let v3 = add(v1, v2)
    return length_sum(v3)
}
