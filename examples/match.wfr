enum Result[T, E] {
    Ok(T),
    Err(E),
}

fn describe(r: Result[i32, String]) -> i32 {
    return match r {
        Ok(v) => v,
        Err(e) => 0,
    }
}

fn classify(x: i32) -> String {
    return match x {
        0 => "zero",
        1 => "one",
        _ => "other",
    }
}

fn main() -> i32 {
    let r1 = Ok(42)
    let r2 = Err("fail")
    let a = describe(r1)
    let b = describe(r2)
    return a + b
}
