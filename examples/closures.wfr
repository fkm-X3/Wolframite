fn make_adder(base: i32) -> fn(i32) -> i32 {
    return |x| x + base
}

fn apply(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x)
}

fn main() -> i32 {
    let add_five = make_adder(5)
    let add_ten = |x| { let y = x + 10; y }
    let a = apply(add_five, 3)
    let b = apply(add_ten, 4)
    return a + b
}
