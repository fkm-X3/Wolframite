struct Pair[A, B] {
    first: A,
    second: B,
}

enum Option[T] {
    Some(T),
    None,
}

fn first[A, B](p: Pair[A, B]) -> A {
    return p.first
}

fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
    return Pair{ .first = p.second, .second = p.first }
}

fn main() -> i32 {
    let p = Pair{ .first = 10, .second = 20 }
    let a = first(p)
    let q = swap(p)
    return a + q.second
}
