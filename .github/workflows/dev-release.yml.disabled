# Rebuilds (clobbers) the rolling "dev" release on every push to the
# default branch. There is always exactly one release named "dev",
# pointing at the latest commit, with the latest ore binaries attached.

name: dev release

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: dev-release
  cancel-in-progress: true

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          submodules: recursive
          fetch-depth: 0

      - name: Install Zig
        uses: mlugg/setup-zig@v2
        with:
          version: 0.16.0

      - name: Build ore (linux x86_64)
        run: zig build -Doptimize=ReleaseSafe -Dcpu=baseline -Dgit-sha=${{ github.sha }}

      - name: Build ore (windows x86_64)
        run: zig build -Doptimize=ReleaseSafe -Dcpu=baseline -Dtarget=x86_64-windows -p zig-out-win -Dgit-sha=${{ github.sha }}

      - name: Stage release assets
        run: |
          mkdir -p dist
          cp zig-out/bin/ore dist/ore-linux-x86_64
          cp zig-out-win/bin/ore.exe dist/ore-windows-x86_64.exe

      - name: Clobber dev release
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release delete dev --yes --cleanup-tag || true

      - name: Publish dev release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release create dev \
            --prerelease \
            --title "dev build (${{ github.sha }})" \
            --notes "Automated development build from commit \`${{ github.sha }}\`. Install or update with: \`ore update\`" \
            dist/ore-linux-x86_64 dist/ore-windows-x86_64.exe